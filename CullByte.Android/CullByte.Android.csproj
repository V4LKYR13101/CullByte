<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <ApplicationId>app.cullbyte.android</ApplicationId>
    <ApplicationTitle>CullByte</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Android.App;Android.Widget" />
    <PackageReference Include="Avalonia.Android" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <AvaloniaXaml Include="../App.axaml" Link="App.axaml" />
    <Compile Include="../MapPaint.cs" Link="Shared/MapPaint.cs" />
    <Compile Include="../SizeText.cs" Link="Shared/SizeText.cs" />
    <Compile Include="../StoragePalette.cs" Link="Shared/StoragePalette.cs" />
    <Compile Include="../Ui.cs" Link="Shared/Ui.cs" />
  </ItemGroup>
</Project>

